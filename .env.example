# Copy to .env, or export these directly. The environment overrides config.toml.
# Nothing here is secret: diAIry has no credentials, because it talks to nothing.

# Where your raw Markdown lives. Anywhere you like: an external drive, a USB
# stick, an encrypted volume. This is the only irreplaceable directory.
DIAIRY_VAULT_PATH=/Users/you/diAIry/vault

# Where derived data lives. Safe to delete: it rebuilds from the vault.
# DIAIRY_DATA_DIR=/Users/you/Library/Application Support/diAIry

# Which models this machine can run: small | medium | large | fake
DIAIRY_MODEL_PROFILE=medium

# The local model server. The only address the egress guard lets through.
# DIAIRY_OLLAMA_HOST=127.0.0.1
# DIAIRY_OLLAMA_PORT=11434
